{
  "target_repo_root": "C:/mycode/Kristal/kristal-framework",
  "execution": {
    "max_parallel": 4,
    "default_timeout_seconds": 180
  },
  "implementation_adapter": {
    "enabled": false,
    "cwd": "../kristal-reference",
    "commands": {
      "exchange_id": [
        "python",
        "-m",
        "kristal_ref",
        "exchange-id",
        "{input}"
      ],
      "verify_exchange": [
        "python",
        "-m",
        "kristal_ref",
        "verify-exchange",
        "{input}"
      ],
      "build_runtime_pack": [
        "python",
        "-m",
        "kristal_ref",
        "build-runtime-pack",
        "{input}",
        "{output_dir}"
      ],
      "verify_runtime_pack": [
        "python",
        "-m",
        "kristal_ref",
        "verify-runtime-pack",
        "{manifest}",
        "{payload_dir}"
      ],
      "verify_signature": [
        "python",
        "-m",
        "kristal_ref",
        "verify-signature",
        "{fixture}"
      ],
      "verify_trust": [
        "python",
        "-m",
        "kristal_ref",
        "verify-trust",
        "{fixture}"
      ]
    }
  }
}
