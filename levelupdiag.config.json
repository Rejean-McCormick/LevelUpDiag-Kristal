{
  "schema": "levelupdiag.config.v2",
  "target_repo_root": "../kristal-framework",
  "control_dir": ".levelupdiag",
  "execution": {
    "max_parallel": 4,
    "default_timeout_seconds": 120,
    "fail_fast": false,
    "capture_limit_kb": 256,
    "protect_tracked_files": true,
    "allow_target_mutation": false,
    "allow_network": false
  },
  "scan": {
    "exclude_dirs": [
      ".git",
      ".hg",
      ".svn",
      ".levelupdiag",
      "levelupdiag",
      "node_modules",
      "vendor",
      "dist",
      "build",
      "target",
      ".venv",
      "venv",
      "__pycache__",
      ".cache",
      "coverage",
      ".tox",
      ".mypy_cache",
      ".pytest_cache"
    ],
    "max_files": 20000,
    "max_file_bytes": 1048576,
    "max_security_files": 4000,
    "large_file_bytes": 10485760
  },
  "toolchain": {
    "required": [],
    "optional": []
  },
  "validators": [
    {
      "id": "kristal-release",
      "name": "Kristal framework/release integrity",
      "command": [
        "python",
        "tools/validate_release.py"
      ],
      "cwd": ".",
      "required": true,
      "timeout_seconds": 120,
      "mutates_target": false,
      "network": false
    },
    {
      "id": "version-alignment",
      "name": "Kristal version alignment",
      "command": [
        "python",
        "tools/check_version_alignment.py"
      ],
      "cwd": ".",
      "required": true,
      "timeout_seconds": 60,
      "mutates_target": false,
      "network": false
    },
    {
      "id": "docs-links",
      "name": "Kristal documentation links/navigation",
      "command": [
        "python",
        "tools/check_docs.py"
      ],
      "cwd": ".",
      "required": true,
      "timeout_seconds": 60,
      "mutates_target": false,
      "network": false
    },
    {
      "id": "jcs-vectors",
      "name": "Kristal JCS vectors",
      "command": [
        "node",
        "tools/check_jcs_vectors.mjs"
      ],
      "cwd": ".",
      "required": true,
      "timeout_seconds": 60,
      "mutates_target": false,
      "network": false
    },
    {
      "id": "manifest-generator",
      "name": "Manifest generator consistency (diagnostic)",
      "command": [
        "python",
        "tools/build_manifests.py",
        "--check"
      ],
      "cwd": ".",
      "required": false,
      "timeout_seconds": 60,
      "mutates_target": false,
      "network": false
    }
  ],
  "security": {
    "enabled": true,
    "scan_untracked": false,
    "additional_patterns": [],
    "additional_excluded_globs": []
  },
  "redaction": {
    "enabled": true,
    "replacement": "<REDACTED>"
  },
  "control_root": "tool"
}
